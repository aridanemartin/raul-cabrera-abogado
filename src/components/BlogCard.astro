---
import { Image } from 'astro:assets';
import { CLUSTERS, formatDate, readingMinutes } from '../lib/blog';
import { coverOf, type Post } from '../lib/posts';

interface Props {
  post: Post;
  /** h2 en el índice del blog; h3 dentro de «Sigue leyendo». */
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 2 } = Astro.props;
const { data } = post;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const cover = coverOf(post);
---

<li class="card" data-cluster={data.cluster}>
  <!-- Decorativa: el título de al lado ya dice de qué va. -->
  <Image
    class="cover"
    src={cover.src}
    alt=""
    widths={[400, 640, 800]}
    sizes="(min-width: 900px) 22rem, (min-width: 600px) 50vw, 100vw"
    width={800}
    height={419}
    fit="cover"
  />
  <p class="eyebrow">{CLUSTERS[data.cluster]}</p>
  <Heading class="title"><a href={`/blog/${post.id}/`}>{data.h1}</a></Heading>
  {data.lead && <p class="excerpt">{data.lead}</p>}
  <p class="meta">
    <time datetime={data.datePublished.toISOString()}>{formatDate(data.datePublished)}</time>
    {` · ${readingMinutes(post.body ?? '')} min de lectura`}
  </p>
</li>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  /* El filtro por tema oculta tarjetas con `hidden`; sin esto, display: grid lo anularía. */
  .card[hidden] {
    display: none;
  }

  .cover {
    width: 100%;
    height: auto;
    aspect-ratio: 1.91 / 1;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .title {
    font-size: var(--step-1);
  }

  .title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  /* Toda la tarjeta es clicable, pero el enlace sigue siendo solo el título. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .card:hover .title a {
    color: var(--color-accent-strong);
    text-decoration: underline;
  }

  .excerpt {
    display: -webkit-box;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.9375rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .meta {
    color: var(--color-muted);
    font-size: var(--step--1);
  }
</style>
