---
import { SITE } from '../config/site';
import { DEFAULT_WHATSAPP_TEXT, buildWhatsAppUrl } from '../lib/whatsapp';
---

<div class="contact-bar" data-contact-bar role="region" aria-label="Contacto rápido">
  <a class="btn btn--primary" href={buildWhatsAppUrl(DEFAULT_WHATSAPP_TEXT)} data-lead="whatsapp" data-lead-location="barra">
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5Z"></path></svg>
    WhatsApp
  </a>
  <a class="btn btn--dark" href={`tel:${SITE.phone.e164}`} data-lead="telefono" data-lead-location="barra">
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"></path></svg>
    Llamar
  </a>
</div>

<style>
  .contact-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-3) calc(var(--space-3) + env(safe-area-inset-bottom));
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -4px 12px rgb(14 42 59 / 6%);
  }

  .contact-bar a {
    flex: 1;
  }

  :global(body) {
    padding-bottom: calc(var(--contact-bar-height) + env(safe-area-inset-bottom));
  }

  @media (min-width: 900px) {
    .contact-bar {
      display: none;
    }

    :global(body) {
      padding-bottom: 0;
    }
  }
</style>
