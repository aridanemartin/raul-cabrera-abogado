---
import Logo from '../assets/raul-cabrera-logo.svg';
import { SITE } from '../config/site';
import { DEFAULT_WHATSAPP_TEXT, buildWhatsAppUrl } from '../lib/whatsapp';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <Logo class="logo" role="img" aria-label="Raúl Cabrera, abogado penalista" />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="visually-hidden">Menú</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Principal">
      <ul>
        {
          SITE.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="menu-contact">
        <a class="btn btn--primary" href={buildWhatsAppUrl(DEFAULT_WHATSAPP_TEXT)} data-lead="whatsapp" data-lead-location="menu">
          Escríbeme por WhatsApp
        </a>
        <p>
          o llama al <a href={`tel:${SITE.phone.e164}`} data-lead="telefono" data-lead-location="menu">{SITE.phone.display}</a>
        </p>
      </div>
    </nav>
    <a class="btn btn--primary header-cta" href={buildWhatsAppUrl(DEFAULT_WHATSAPP_TEXT)} data-lead="whatsapp" data-lead-location="cabecera">
      WhatsApp
    </a>
  </div>
</header>

<script>
  import { bindMenu } from '../scripts/menu';

  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) bindMenu(header);
</script>

<style>
  .site-header {
    /* Por encima de la barra de contacto (40) para que el menú abierto la tape; el aviso de cookies (50) sigue encima. */
    position: relative;
    z-index: 45;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
  }

  .brand,
  .menu-toggle {
    /* Por encima del menú abierto, que ocupa toda la pantalla. */
    position: relative;
    z-index: 1;
    transition: color 0.3s ease;
  }

  /* El logo se pinta con el color del texto: azul en la barra y blanco con el menú abierto. */
  .brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--color-ink);
  }

  .brand :global(.logo) {
    width: auto;
    height: 3rem;
  }

  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .menu-toggle[hidden] {
    display: none;
  }

  /* Hamburguesa: la barra corta se alarga al pasar el ratón; al abrir, el icono gira y las barras forman una X. */
  .menu-icon {
    position: relative;
    width: 26px;
    height: 18px;
    transition: transform 0.5s cubic-bezier(0.7, 0, 0.2, 1);
  }

  .menu-icon span {
    position: absolute;
    right: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.5s cubic-bezier(0.7, 0, 0.2, 1),
      opacity 0.25s ease,
      width 0.3s ease;
  }

  .menu-icon span:nth-child(1) {
    top: 0;
  }

  .menu-icon span:nth-child(2) {
    top: 8px;
    width: 65%;
  }

  .menu-icon span:nth-child(3) {
    top: 16px;
  }

  .menu-toggle:hover .menu-icon span:nth-child(2) {
    width: 100%;
  }

  .menu-toggle[aria-expanded='true'] .menu-icon {
    transform: rotate(180deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-icon span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-icon span:nth-child(2) {
    opacity: 0;
    transform: translateX(-12px);
  }

  .menu-toggle[aria-expanded='true'] .menu-icon span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .site-header[data-menu-open] .brand,
  .site-header[data-menu-open] .menu-toggle {
    color: #fff;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  .site-nav {
    flex-basis: 100%;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--color-accent-strong);
    text-decoration: underline;
  }

  .menu-contact {
    display: none;
  }

  /* Menú a pantalla completa: se abre como un círculo que crece desde el botón y los enlaces entran uno tras otro. */
  @media (max-width: 899px) {
    .site-nav[data-collapsible] {
      position: fixed;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--space-6);
      padding: calc(var(--tap) + 2 * var(--space-3) + var(--space-6)) var(--space-4)
        calc(var(--space-6) + env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--color-ink);
      clip-path: circle(0 at var(--menu-x, calc(100% - 2.5rem)) var(--menu-y, 2.25rem));
      visibility: hidden;
      transition:
        clip-path 0.6s cubic-bezier(0.7, 0, 0.2, 1),
        visibility 0s linear 0.6s;
    }

    .site-header[data-menu-open] .site-nav[data-collapsible] {
      clip-path: circle(150% at var(--menu-x, calc(100% - 2.5rem)) var(--menu-y, 2.25rem));
      visibility: visible;
      transition:
        clip-path 0.6s cubic-bezier(0.7, 0, 0.2, 1),
        visibility 0s;
    }

    .site-nav[data-collapsible] ul {
      display: grid;
      gap: var(--space-2);
    }

    .site-nav[data-collapsible] li,
    .site-nav[data-collapsible] .menu-contact {
      opacity: 0;
      transform: translateY(1.25rem);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    .site-header[data-menu-open] .site-nav[data-collapsible] li,
    .site-header[data-menu-open] .site-nav[data-collapsible] .menu-contact {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.5s ease calc(0.2s + var(--i, 0) * 0.06s),
        transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) calc(0.2s + var(--i, 0) * 0.06s);
    }

    .site-nav li:nth-child(2) {
      --i: 1;
    }

    .site-nav li:nth-child(3) {
      --i: 2;
    }

    .site-nav li:nth-child(4) {
      --i: 3;
    }

    .site-nav li:nth-child(5) {
      --i: 4;
    }

    .site-nav li:nth-child(6) {
      --i: 5;
    }

    .site-nav li:nth-child(7) {
      --i: 6;
    }

    .site-nav[data-collapsible] a {
      color: #fff;
      font-size: var(--step-3);
      font-weight: 800;
      letter-spacing: -0.02em;
      text-decoration: none;
    }

    .site-nav[data-collapsible] a:not(.btn):hover,
    .site-nav[data-collapsible] a[aria-current='page'] {
      color: #9ed8df;
      text-decoration: none;
    }

    .site-nav[data-collapsible] a:focus-visible {
      outline-color: #9ed8df;
    }

    .site-nav[data-collapsible] .menu-contact {
      --i: 7;
      display: grid;
      gap: var(--space-2);
      color: #e7e1df;
      text-align: center;
    }

    .site-nav[data-collapsible] .menu-contact a:not(.btn) {
      display: inline-flex;
      font-size: inherit;
      font-weight: 700;
      text-decoration: underline;
    }

    .site-nav[data-collapsible] .menu-contact .btn {
      justify-content: center;
      font-size: var(--step-0);
      letter-spacing: normal;
    }
  }

  @media (max-width: 899px) and (prefers-reduced-motion: reduce) {
    .site-nav[data-collapsible],
    .site-nav[data-collapsible] li,
    .site-nav[data-collapsible] .menu-contact {
      transition-delay: 0s !important;
    }
  }

  .header-cta {
    display: none;
  }

  @media (min-width: 900px) {
    .menu-toggle {
      display: none;
    }

    .header-cta {
      display: inline-flex;
    }

    .site-nav {
      flex-basis: auto;
    }
  }
</style>
