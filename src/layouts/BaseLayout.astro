---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactBar from '../components/ContactBar.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { SITE } from '../config/site';
import { buildBreadcrumbs, buildSiteGraph } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  breadcrumbs?: { name: string; path: string }[];
  jsonLd?: object[];
  ogType?: 'website' | 'article';
  /** Página 404: sin canonical y siempre noindex. */
  notFound?: boolean;
}

const { title, description, breadcrumbs, jsonLd = [], ogType = 'website', notFound = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true' && !notFound;
const structuredData = [buildSiteGraph(), ...(breadcrumbs?.length ? [buildBreadcrumbs(breadcrumbs)] : []), ...jsonLd];
const toJson = (data: object) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!notFound && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL(SITE.ogImage.path, SITE.url).href} />
    <meta property="og:image:width" content={String(SITE.ogImage.width)} />
    <meta property="og:image:height" content={String(SITE.ogImage.height)} />
    <meta property="og:image:alt" content={SITE.ogImage.alt} />
    <meta name="theme-color" content="#0F7C8C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-manrope" preload />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {structuredData.map((data) => <script type="application/ld+json" set:html={toJson(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <ContactBar />
    <ConsentBanner />
  </body>
</html>
