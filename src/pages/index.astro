---
import { Picture, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import TrustStrip from '../components/TrustStrip.astro';
import UrgencyCard from '../components/UrgencyCard.astro';
import { FULL_ADDRESS, SITE } from '../config/site';
import heroPhoto from '../assets/raul-cabrera-portada.jpg';
import heroPhotoWide from '../assets/raul-cabrera-portada-ancha.jpg';
import whyPhoto from '../assets/raul-cabrera-por-que.jpg';

const services = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);

// La portada cambia de foto según el ancho: desde 1440 px va la de fondo liso, más apaisada,
// para que se vea de la cabeza al pecho; por debajo, la del despacho. <Picture> no admite
// una foto distinta por media query, así que el <picture> se monta a mano.
const heroFormats = ['avif', 'webp'] as const;
const heroVariants = [
  { src: heroPhotoWide, media: '(min-width: 1440px)', widths: [1440, 1840], sizes: 'min(100vw, 99rem)' },
  { src: heroPhoto, media: undefined, widths: [480, 768, 1080, 1440, 1672], sizes: '100vw' },
];
const heroSources = await Promise.all(
  heroVariants.flatMap(({ src, media, widths, sizes }) =>
    heroFormats.map(async (format) => {
      const image = await getImage({ src, format, widths, sizes });
      return { media, type: `image/${format}`, srcset: image.srcSet.attribute, sizes, width: src.width, height: src.height };
    }),
  ),
);
const heroFallback = await getImage({ src: heroPhoto, format: 'jpg', widths: heroVariants[1].widths, sizes: '100vw' });

// Iconos de trazo (24×24) del índice de servicios, por el nombre del archivo en src/content/servicios.
const serviceIcons: Record<string, string> = {
  'asistencia-detenido-investigado':
    '<path d="M7 18v-6a5 5 0 0 1 10 0v6"/><path d="M5 21a1 1 0 0 1-1-1v-1a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v1a1 1 0 0 1-1 1Z"/><path d="M21 12h1"/><path d="M18.5 4.5 18 5"/><path d="M2 12h1"/><path d="M12 2v1"/><path d="m4.9 4.9.7.7"/>',
  'alcoholemia-delitos-trafico':
    '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>',
  'violencia-genero-domestica': '<path d="m3 10 9-7 9 7v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M9 22V12h6v10"/>',
  'lesiones-amenazas-delitos-leves':
    '<path d="m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
  'acusacion-particular':
    '<path d="m16 16 3-8 3 8c-.9.7-1.9 1-3 1s-2.1-.3-3-1Z"/><path d="m2 16 3-8 3 8c-.9.7-1.9 1-3 1s-2.1-.3-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>',
  'recursos-antecedentes': '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>',
};

const steps = [
  {
    title: 'Me escribes o me llamas',
    text: 'Por WhatsApp o por teléfono. Me cuentas en pocas líneas qué ha pasado y cuándo es la próxima cita con el juzgado, si la hay.',
  },
  {
    title: 'Te explico qué puede pasar',
    text: 'Con palabras claras: qué te juegas, qué opciones tienes y cuánto costará. El presupuesto te lo doy siempre por escrito antes de empezar.',
  },
  {
    title: 'Te acompaño hasta el final',
    text: 'Desde la comisaría o la primera citación hasta la sentencia y, si hace falta, el recurso. Siempre hablas conmigo.',
  },
];

// Iconos de trazo (24×24) para cada motivo.
const reasons = [
  {
    title: `Colegiado desde ${SITE.lawyer.since}`,
    text: `Con el número ${SITE.lawyer.colegiado} del ${SITE.lawyer.colegio}.`,
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
  },
  {
    title: 'En todas las islas',
    text: 'Llevo asuntos en todo el archipiélago, no solo en Las Palmas de Gran Canaria.',
    icon: '<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  },
  {
    title: 'Trato directo',
    text: 'Tu caso lo llevo yo, de principio a fin, y hablas siempre conmigo.',
    icon: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  },
  {
    title: 'Sin sorpresas',
    text: 'Antes de empezar sabes qué vamos a hacer y cuánto va a costar, por escrito.',
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  },
];
---

<BaseLayout
  title="Abogado penalista en Las Palmas de Gran Canaria | Raúl Cabrera"
  description="Raúl Cabrera Santana, abogado penalista colegiado en Las Palmas. Defensa penal desde la comisaría hasta la sentencia. Escríbeme por WhatsApp."
>
  <section class="hero">
    <div class="hero-media">
      <picture>
        {heroSources.map((source) => <source {...source} />)}
        <img
          src={heroFallback.src}
          srcset={heroFallback.srcSet.attribute}
          sizes="100vw"
          width={heroPhoto.width}
          height={heroPhoto.height}
          alt="Raúl Cabrera Santana, abogado penalista en Las Palmas de Gran Canaria"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      </picture>
    </div>
    <div class="container hero-text">
      <p class="eyebrow">Las Palmas de Gran Canaria · Todas las islas</p>
      <h1>Abogado penalista en Las Palmas de Gran Canaria</h1>
      <p class="lead">
        Defensa penal urgente en comisaría, juzgados y juicios rápidos. Protejo tus derechos desde el primer minuto con una estrategia clara.
      </p>
      <UrgencyCard location="hero" />
      <TrustStrip />
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="servicios">
    <div class="container services">
      <div class="services-head">
        <h2 id="servicios">En qué puedo ayudarte</h2>
        <p>Elige lo que te ha pasado y te explico qué puede ocurrir y qué hacer ahora.</p>
      </div>
      <ul class="service-list">
        {
          services.map((service) => (
            <li class="service-row">
              {serviceIcons[service.id] && (
                <span class="service-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={serviceIcons[service.id]} />
                </span>
              )}
              <div>
                <h3>
                  <a href={`/servicios/${service.id}/`}>{service.data.cardTitle}</a>
                </h3>
                <p>{service.data.cardHook}</p>
              </div>
              <span class="service-arrow" aria-hidden="true">→</span>
            </li>
          ))
        }
      </ul>
      <a class="services-link" href="/servicios/">Ver todos los servicios <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section steps-band" aria-labelledby="como-trabajo">
    <div class="container">
      <div class="steps-head">
        <h2 id="como-trabajo">Cómo trabajo</h2>
        <p>Tres pasos, sin letra pequeña. Desde el primer mensaje sabes qué está pasando y cuánto va a costar.</p>
      </div>
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li>
              <span class="step-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <a class="steps-link" href="/sobre-raul/#como-trabajo">Cómo trabajo, paso a paso <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="por-que">
    <div class="container why">
      <div class="why-photo">
        <Picture
          src={whyPhoto}
          formats={['avif', 'webp']}
          widths={[360, 540, 720, 1080]}
          sizes="(min-width: 900px) 28rem, calc(100vw - 3rem)"
          alt="Raúl Cabrera Santana, abogado penalista, consultando un libro"
        />
      </div>
      <div>
        <h2 id="por-que">Por qué conmigo</h2>
        <ul class="reasons">
          {
            reasons.map((reason) => (
              <li>
                <span class="reason-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={reason.icon} />
                </span>
                <div>
                  <strong>{reason.title}</strong>
                  <p>{reason.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <a class="why-link" href="/sobre-raul/">Más sobre mí <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <GoogleReviews />

  <section class="section" aria-labelledby="contacto">
    <div class="container contact">
      <div>
        <h2 id="contacto">Cuéntame tu caso</h2>
        <p>
          Rellena estos tres datos y se abrirá WhatsApp con el mensaje preparado. Si lo prefieres, llámame al <a
            href={`tel:${SITE.phone.e164}`}
            data-lead="telefono"
            data-lead-location="portada">{SITE.phone.display}</a
          >.
        </p>
        <p class="address">Despacho: {FULL_ADDRESS}</p>
      </div>
      <ContactForm location="portada" />
    </div>
  </section>
</BaseLayout>

<style>
  /* En el móvil la foto va arriba y el texto debajo; desde 900 px la foto
     ocupa la cabecera y el texto queda sobre la parte oscura de la izquierda. */
  .hero {
    /* Color de la pared de la foto: la continúa por debajo y hacia los lados. */
    --hero-bg: #39322f;
    background: var(--hero-bg);
    padding-bottom: var(--space-7);
  }

  /* El ancho explícito hace falta: con aspect-ratio y ancho automático, el max-height
     también limita el ancho (26rem × 16/10) y la foto no llegaba al borde entre ~670 y 900 px. */
  .hero-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 26rem;
    overflow: hidden;
  }

  .hero-media :global(picture),
  .hero-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-media :global(img) {
    object-fit: cover;
    object-position: 80% top;
  }

  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 55%, var(--hero-bg));
  }

  .hero-text {
    display: grid;
    gap: var(--space-4);
  }

  .hero .eyebrow {
    color: #9ed8df;
  }

  .hero h1 {
    color: #fff;
  }

  .lead {
    max-width: 36rem;
    color: #e7e1df;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .hero :global(.trust),
  .hero :global(.trust a) {
    color: #e7e1df;
  }

  .hero :global(.trust p:first-child) {
    color: #fff;
  }

  .hero :global(.trust a:focus-visible) {
    outline-color: #fff;
  }

  @media (min-width: 900px) {
    .hero {
      position: relative;
      display: grid;
      align-items: center;
      min-height: clamp(34rem, 42vw, 46rem);
      padding-block: var(--space-7);
    }

    /* La foto va pegada a la derecha de un marco centrado de 110rem, siempre a la altura
       de la cabecera y sin estirarse más allá de su proporción: en pantallas anchas se ve
       de la cabeza al pecho y el hueco que sobra es color de pared. */
    .hero-media {
      position: absolute;
      inset-block: 0;
      inset-inline: max(0px, (100% - 110rem) / 2);
      width: auto;
      aspect-ratio: auto;
      max-height: none;
    }

    .hero-media :global(picture) {
      position: absolute;
      inset: 0;
    }

    .hero-media :global(img) {
      position: absolute;
      top: 0;
      right: 0;
      width: auto;
      object-position: right top;
      mask-image: linear-gradient(to right, transparent, #000 30%);
    }

    .hero-media::after {
      background: linear-gradient(to right, var(--hero-bg) 30%, rgb(57 50 47 / 0%) 60%);
    }

    .hero-text {
      position: relative;
      justify-items: start;
    }

    .hero-text > * {
      max-width: 32rem;
    }
  }

  /* Con la pantalla más ancha que el marco, su borde derecho se funde con la pared. */
  @media (min-width: 110rem) {
    .hero-media {
      mask-image: linear-gradient(to right, #000 calc(100% - 6rem), transparent);
    }
  }

  h2 {
    margin-bottom: var(--space-5);
  }

  /* Índice de servicios: una fila clicable por servicio (icono, título, una línea y flecha).
     En el móvil, lista seguida con el enlace a todos los servicios al final; desde 768 px,
     dos columnas y el enlace junto al título; desde 1024 px, tres columnas. */
  .services {
    display: grid;
    gap: var(--space-5);
  }

  .services-head {
    display: grid;
    gap: var(--space-2);
  }

  .services h2 {
    margin-bottom: 0;
  }

  .services-head p {
    max-width: 34rem;
    color: var(--color-muted);
  }

  .service-list {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .service-row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.875rem;
    align-items: center;
    min-height: 4.75rem;
    padding: 0.875rem var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .service-row:hover,
  .service-row:focus-within {
    border-color: var(--color-accent);
  }

  .service-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 10px;
    background: var(--color-surface);
    color: var(--color-accent-strong);
  }

  .service-row h3 {
    font-size: var(--step-0);
    line-height: 1.25;
  }

  .service-row a {
    color: var(--color-ink);
    text-decoration: none;
  }

  /* Toda la fila es clicable sin anidar enlaces. */
  .service-row a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .service-row p {
    margin-top: 0.125rem;
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: 1.45;
  }

  .service-arrow {
    color: var(--color-accent-strong);
    font-weight: 800;
    transition: transform 0.2s ease;
  }

  .service-row:hover .service-arrow {
    transform: translateX(4px);
  }

  .services-link {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--space-2);
    min-height: var(--tap);
    color: var(--color-accent-strong);
    font-weight: 700;
  }

  .services-link span {
    transition: transform 0.2s ease;
  }

  .services-link:hover span {
    transform: translateX(4px);
  }

  @media (min-width: 768px) {
    .services {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-6);
    }

    .services-head {
      grid-area: 1 / 1;
    }

    .services-link {
      grid-area: 1 / 2;
      align-self: end;
    }

    .service-list {
      grid-column: 1 / -1;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }

    .service-row {
      height: 100%;
    }
  }

  @media (min-width: 1024px) {
    .service-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  /* Banda oscura entre las dos secciones claras: en el móvil, pasos en fila separados por una
     raya, con el número a la izquierda; desde 768 px, tres columnas con números grandes. */
  .steps-band {
    --steps-tint: #9ed8df;
    --steps-text: #c5d3da;
    --steps-rule: rgb(255 255 255 / 14%);
    background: var(--color-ink);
    color: #fff;
  }

  .steps-head {
    display: grid;
    gap: var(--space-3);
  }

  .steps-band h2 {
    margin-bottom: 0;
  }

  .steps-head p {
    max-width: 30rem;
    color: var(--steps-text);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .steps {
    display: grid;
    margin-block: var(--space-6) var(--space-2);
    padding: 0;
    list-style: none;
  }

  /* align-content evita que, en columnas de distinta altura, se estiren las filas y los títulos queden descolocados. */
  .steps li {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: var(--space-1) var(--space-3);
    align-content: start;
    padding-block: var(--space-5);
    border-top: 1px solid var(--steps-rule);
  }

  .step-number {
    grid-row: span 2;
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--steps-tint);
  }

  .steps h3 {
    padding-top: 0.375rem;
  }

  .steps p {
    color: var(--steps-text);
  }

  .steps-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    color: var(--steps-tint);
    font-weight: 700;
  }

  .steps-link:hover {
    color: #fff;
  }

  .steps-link span {
    transition: transform 0.2s ease;
  }

  .steps-link:hover span {
    transform: translateX(4px);
  }

  .steps-link:focus-visible {
    outline-color: #fff;
  }

  @media (min-width: 768px) {
    .steps-band {
      padding-block: var(--space-8);
    }

    .steps-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-6);
      align-items: end;
    }

    .steps-head p {
      justify-self: end;
    }

    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-block: var(--space-7) var(--space-5);
    }

    .steps li {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      padding: 0 var(--space-6);
      border-top: 0;
      border-left: 1px solid var(--steps-rule);
    }

    .steps li:first-child {
      padding-left: 0;
      border-left: 0;
    }

    .step-number {
      grid-row: auto;
      margin-bottom: var(--space-3);
      font-size: 4.5rem;
      -webkit-text-stroke-width: 2px;
    }

    .steps h3 {
      padding-top: 0;
    }
  }

  /* Foto grande con un marco desplazado detrás; en el ordenador, foto a la izquierda y motivos a la derecha. */
  .why {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .why-photo {
    position: relative;
    width: calc(100% - var(--space-4));
    max-width: 28rem;
  }

  .why-photo::before {
    content: '';
    position: absolute;
    inset: var(--space-4) calc(-1 * var(--space-4)) calc(-1 * var(--space-4)) var(--space-4);
    border: 2px solid var(--color-accent);
    border-radius: 20px;
  }

  .why-photo :global(picture),
  .why-photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .why-photo :global(img) {
    position: relative;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 18px 40px rgb(14 42 59 / 18%);
  }

  .reasons {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .reasons li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-4);
    background: var(--color-bg);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .reason-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 10px;
    background: var(--color-surface);
    color: var(--color-accent-strong);
  }

  .reasons strong {
    display: block;
    margin-bottom: var(--space-1);
    font-size: var(--step-0);
  }

  .reasons p {
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .why-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    color: var(--color-accent-strong);
    font-weight: 700;
  }

  .why-link span {
    transition: transform 0.2s ease;
  }

  .why-link:hover span {
    transform: translateX(4px);
  }

  @media (min-width: 600px) {
    .reasons {
      grid-template-columns: repeat(2, minmax(0, 1fr));
