---
import PageLayout from '../layouts/PageLayout.astro';

const googleCookies = 'https://support.google.com/analytics/answer/11397207?hl=es';

const columns = ['Nombre', 'Para qué sirve', 'Duración', 'De quién es'];
const cookies = [
  {
    name: '_ga',
    purpose: 'Distingue a unos visitantes de otros para contar cuántas personas visitan la web.',
    duration: '2 años',
    owner: 'Google Analytics. Solo si aceptas.',
  },
  {
    name: '_ga_<ID>',
    purpose: 'Mantiene los datos de la visita en curso, lo que Google llama la sesión.',
    duration: '2 años',
    owner: 'Google Analytics. Solo si aceptas.',
  },
  {
    name: 'rc-consent',
    purpose:
      'Recuerda si aceptaste o rechazaste las cookies de análisis, para no volver a preguntarte. No es una cookie sino un dato guardado en tu navegador, y no se envía a nadie.',
    duration: '1 año',
    owner: 'Esta web. Es necesario, así que no pide permiso.',
  },
];
---

<PageLayout
  title="Política de cookies | Raúl Cabrera Abogado"
  description="Qué cookies usa esta web (solo las de Google Analytics, y solo si aceptas), para qué sirven, cuánto duran y cómo cambiar tu elección."
  h1="Política de cookies"
  lead="Esta web solo usa cookies de análisis, y solo si las aceptas. Aquí puedes ver cuáles son y cambiar tu elección."
  crumb="Cookies"
>
  <section class="settings" data-cookie-settings aria-labelledby="tu-eleccion">
    <h2 id="tu-eleccion">Tu elección</h2>
    <p data-cookie-status role="status">Sin JavaScript activado, Google Analytics no se carga.</p>
    <div class="controls" data-cookie-controls hidden>
      <button type="button" class="btn btn--dark" data-cookie-choice="accept">Aceptar</button>
      <button type="button" class="btn btn--dark" data-cookie-choice="reject">Rechazar</button>
    </div>
  </section>

  <h2>Qué son las cookies</h2>
  <p>
    Son pequeños archivos que una web guarda en tu navegador para recordar información de una visita a otra. Algunas son
    necesarias para que la web funcione. Otras sirven para medir las visitas, y esas solo se pueden usar si las aceptas.
  </p>

  <h2>Qué cookies usa esta web</h2>
  <table role="table">
    <caption>Cookies y datos que esta web guarda en tu navegador</caption>
    <thead role="rowgroup">
      <tr role="row">{columns.map((column) => <th scope="col" role="columnheader">{column}</th>)}</tr>
    </thead>
    <tbody role="rowgroup">
      {
        cookies.map((cookie) => (
          <tr role="row">
            <td role="cell" data-label={columns[0]}>
              <code>{cookie.name}</code>
            </td>
            <td role="cell" data-label={columns[1]}>{cookie.purpose}</td>
            <td role="cell" data-label={columns[2]}>{cookie.duration}</td>
            <td role="cell" data-label={columns[3]}>{cookie.owner}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p>
    {'<ID>'} es el código de esta web en Google Analytics. Las duraciones son las que fija Google por defecto y se cuentan
    desde tu última visita. Google lo explica en su página sobre el <a href={googleCookies}
      >uso de cookies de Google Analytics</a
    >.
  </p>

  <h2>Cómo borrar las cookies</h2>
  <p>
    Si pulsas «Rechazar», la web borra las cookies de Google Analytics que ya estuvieran guardadas. También puedes borrar
    todas las cookies desde la configuración de tu navegador, normalmente en el apartado de privacidad o de historial.
  </p>
  <p>Cómo trato tus datos lo explico en la <a href="/privacidad/">política de privacidad</a>.</p>
</PageLayout>

<style>
  .settings {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .settings h2 {
    margin: 0;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .controls[hidden] {
    display: none;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  caption {
    text-align: left;
    font-weight: 700;
    padding-bottom: var(--space-2);
  }

  th,
  td {
    padding: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  /* En pantallas estrechas cada cookie es una ficha con sus etiquetas. */
  @media (max-width: 40rem) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    tr {
      display: block;
      padding-block: var(--space-3);
      border-bottom: 1px solid var(--color-border);
    }

    td {
      display: grid;
      grid-template-columns: 7rem 1fr;
      gap: var(--space-2);
      padding: var(--space-1) 0;
      border: 0;
    }

    td::before {
      content: attr(data-label);
      font-weight: 700;
    }
  }
</style>
