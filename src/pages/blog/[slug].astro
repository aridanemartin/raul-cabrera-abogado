---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { relatedPosts } from '../../lib/blog';
import { getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, related: relatedPosts(post, posts, 3) } }));
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} related={related}>
  <Content />
</PostLayout>
