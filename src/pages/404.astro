---
import BaseLayout from '../layouts/BaseLayout.astro';
import UrgencyCard from '../components/UrgencyCard.astro';
---

<BaseLayout
  title="Página no encontrada | Raúl Cabrera Abogado"
  description="Esta página no existe o ha cambiado de dirección. Desde aquí puedes ir a la guía de urgencia, a los servicios o al contacto."
  notFound
>
  <div class="container page">
    <h1>No encuentro esta página</h1>
    <p class="lead">Puede que la dirección haya cambiado. Esto es lo que suele buscar quien llega aquí:</p>
    <ul class="links">
      <li><a href="/te-han-detenido/">¿Te han detenido? Qué hacer ahora</a></li>
      <li><a href="/juicio-rapido/">¿Tienes un juicio rápido? Cómo prepararlo</a></li>
      <li><a href="/servicios/">Casos que llevo</a></li>
      <li><a href="/contacto/">Contacto</a></li>
      <li><a href="/">Ir a la portada</a></li>
    </ul>
    <UrgencyCard location="404" />
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-7);
  }

  .lead {
    max-width: var(--measure);
    color: var(--color-muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .links {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
  }
</style>
